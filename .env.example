# Copy to .env and adjust. NEVER commit the real .env.
# In production these come from AWS Secrets Manager (mounted via the Secrets Store
# CSI driver), not from a file.

# Shared HS256 secret: login-service signs JWTs, authorize-service verifies them.
JWT_SECRET=dev-insecure-change-me

# Local Postgres password (compose only). On AWS this is an RDS-managed credential.
POSTGRES_PASSWORD=platform
